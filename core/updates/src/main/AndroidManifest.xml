<?xml version="1.0" encoding="utf-8"?>
<!--
  The module shows update notifications, so it declares the required
  runtime permission itself. The manifest is merged into the app manifest;
  user denial is handled in UpdateNotifications via areNotificationsEnabled().
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 16+ Live Updates: promoted ongoing download notifications.
         This is a normal (non-runtime) permission; older releases ignore it. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

</manifest>
