<?xml version="1.0" encoding="utf-8"?>
<!-- Base theme without ActionBar: the entire UI is drawn by Compose (Material 3). -->
<resources>
    <style name="Theme.Ruthenia" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Cold-start theme: the system SplashScreen API (via
        core-splashscreen) shows the brand mark on a background matching the
        app surface, then hands over to Theme.Ruthenia.
        This way the launch does not flash white in either light or dark theme.
    -->
    <style name="Theme.Ruthenia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ruthenia</item>
    </style>
</resources>
