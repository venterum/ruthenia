    <string name="onboarding_welcome_title">Welcome</string>
    <string name="onboarding_welcome_body">Ruthenia Store is an open client for installing and updating apps from RuStore. No tracking, no banners, no clutter.</string>
    <string name="onboarding_privacy_title">Private by default</string>
    <string name="onboarding_privacy_body">No analytics and no ad SDKs. The network is used only for the RuStore catalog and downloads plus a one-off download of the official Mintsifry certificates on a manual refresh, and the list of installed apps is read locally.</string>
    <string name="onboarding_install_title">Verified installs</string>
    <string name="onboarding_install_body">Before installing, the downloaded APK signature is checked against the installed app. Multi-APK and split builds install in a single session.</string>
    <string name="onboarding_disclaimer_title">Unofficial client</string>
    <string name="onboarding_disclaimer_body">This project is not affiliated with RuStore or VK and runs on a non-public API. If the API changes, the app may temporarily stop fetching data until it is updated.</string>
