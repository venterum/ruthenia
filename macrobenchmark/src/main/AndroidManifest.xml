<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The benchmark library writes the generated profiles and traces to the
         additional test output directory, which on API 29 needs legacy storage. -->
    <application android:requestLegacyExternalStorage="true" />

    <!-- Android 11+ package visibility: the app under test must be visible to
         UiAutomator (startApplicationAndWait and By.res selectors). -->
    <queries>
        <package android:name="com.vntrum.ruthenia" />
    </queries>
</manifest>
